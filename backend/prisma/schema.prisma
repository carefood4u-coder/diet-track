// DietTrack Prisma schema
// NOTE: role/channel/status fields are plain Strings with values enforced
// in application code (kept from the original SQLite-compatible schema):
//   User.role       -> "ADMIN" | "USER"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  role           String   @default("USER") // "ADMIN" | "USER"
  name           String
  email          String   @unique
  passwordHash   String
  mobile         String?
  heightCm       Float?
  age            Int?
  notifyTime     String   @default("08:00") // "HH:mm", server local time
  notifyEmail    Boolean  @default(true)
  notifyWhatsapp Boolean  @default(false)
  // Diet plan notifications only send while today is within
  // [subscriptionStartsAt, subscriptionEndsAt]. Either side left null means
  // that side is unrestricted (existing clients keep working as before).
  subscriptionStartsAt DateTime?
  subscriptionEndsAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  weightLogs        WeightLog[]
  dietPlans          DietPlan[]
  passwordResetOtps PasswordResetOtp[]
  sendLogs           SendLog[]
}

model WeightLog {
  id       Int      @id @default(autoincrement())
  userId   Int
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg Float
  loggedAt DateTime @default(now())

  @@index([userId])
}

model DietPlan {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     String // "YYYY-MM"
  createdAt DateTime @default(now())

  days DietPlanDay[]

  @@unique([userId, month])
}

model DietPlanDay {
  id         Int      @id @default(autoincrement())
  dietPlanId Int
  dietPlan   DietPlan @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  date       DateTime // date-only, stored at UTC midnight
  notes      String?

  meals    Meal[]
  sendLogs SendLog[]

  @@unique([dietPlanId, date])
}

// A single meal within a day's plan. Trainers name and time these freely
// (e.g. "Meal 1" at 07:00, "Pre-workout" at 16:00) since different clients
// follow different numbers of meals per day - there's no fixed
// breakfast/lunch/dinner structure.
model Meal {
  id            Int         @id @default(autoincrement())
  dietPlanDayId Int
  dietPlanDay   DietPlanDay @relation(fields: [dietPlanDayId], references: [id], onDelete: Cascade)
  name          String // e.g. "Meal 1", "Pre-workout snack"
  time          String // "HH:mm", used to sort meals within the day
  description   String  @default("") // what to eat

  @@index([dietPlanDayId])
}

model PasswordResetOtp {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model SendLog {
  id            Int         @id @default(autoincrement())
  userId        Int
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dietPlanDayId Int
  dietPlanDay   DietPlanDay @relation(fields: [dietPlanDayId], references: [id], onDelete: Cascade)
  channel       String // "EMAIL" | "WHATSAPP"
  status        String // "SENT" | "SKIPPED" | "FAILED"
  sentAt        DateTime    @default(now())

  @@index([userId])
  @@index([dietPlanDayId])
}
