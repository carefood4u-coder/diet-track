// DietTrack Prisma schema
// NOTE: role/channel/status fields are plain Strings with values enforced
// in application code (kept from the original SQLite-compatible schema):
//   User.role       -> "ADMIN" | "USER"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  role           String   @default("USER") // "ADMIN" | "USER"
  name           String
  email          String   @unique
  passwordHash   String
  mobile         String?
  heightCm       Float?
  dateOfBirth    DateTime? // age is calculated from this, not stored
  bloodGroup     String?
  // Daily routine timings ("HH:mm"), used by the trainer to plan meal
  // timing around the client's actual schedule.
  wakeUpTime     String?
  breakfastTime  String?
  lunchTime      String?
  eveningTeaTime String?
  dinnerTime     String?
  sleepTime      String?
  subscriptionStartsAt DateTime?
  subscriptionEndsAt   DateTime?
  // Soft-delete: archived clients are hidden from the default client list
  // but their data (weight logs, diet plans, etc.) is kept.
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  weightLogs        WeightLog[]
  dietPlans          DietPlan[]
  passwordResetOtps PasswordResetOtp[]
}

model WeightLog {
  id       Int      @id @default(autoincrement())
  userId   Int
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg Float
  loggedAt DateTime @default(now())

  @@index([userId])
}

model DietPlan {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     String // "YYYY-MM"
  createdAt DateTime @default(now())

  days DietPlanDay[]

  @@unique([userId, month])
}

model DietPlanDay {
  id         Int      @id @default(autoincrement())
  dietPlanId Int
  dietPlan   DietPlan @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  date       DateTime // date-only, stored at UTC midnight
  notes      String?

  meals Meal[]

  @@unique([dietPlanId, date])
}

// A single meal within a day's plan. Trainers name and time these freely
// (e.g. "Meal 1" at 07:00, "Pre-workout" at 16:00) since different clients
// follow different numbers of meals per day - there's no fixed
// breakfast/lunch/dinner structure.
model Meal {
  id            Int         @id @default(autoincrement())
  dietPlanDayId Int
  dietPlanDay   DietPlanDay @relation(fields: [dietPlanDayId], references: [id], onDelete: Cascade)
  name          String // e.g. "Meal 1", "Pre-workout snack"
  time          String // "HH:mm", used to sort meals within the day
  description   String  @default("") // what to eat

  @@index([dietPlanDayId])
}

model PasswordResetOtp {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

