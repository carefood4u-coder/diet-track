# --- Database ---
# SQLite for local dev. To move to Postgres later, change provider in
# prisma/schema.prisma from "sqlite" to "postgresql" and set DATABASE_URL
# to a Postgres connection string, e.g:
# DATABASE_URL="postgresql://user:password@host:5432/diettrack"
DATABASE_URL="file:./dev.db"

# --- Auth ---
JWT_SECRET="change_this_to_a_long_random_string"

# --- Server ---
PORT=4000

# --- Email (SMTP) ---
# Used for: forgot-password OTP emails only. If left blank, the app logs
# "[Email not configured, skipping]" instead of crashing.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SENDGRID_API_KEY=
