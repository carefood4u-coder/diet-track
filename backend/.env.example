# --- Database ---
# SQLite for local dev. To move to Postgres later, change provider in
# prisma/schema.prisma from "sqlite" to "postgresql" and set DATABASE_URL
# to a Postgres connection string, e.g:
# DATABASE_URL="postgresql://user:password@host:5432/diettrack"
DATABASE_URL="file:./dev.db"

# --- Auth ---
JWT_SECRET="change_this_to_a_long_random_string"

# --- Server ---
PORT=4000

# --- Email (SMTP) ---
# Used for: forgot-password OTP emails and daily diet plan delivery.
# If left blank, the app will log "[Email not configured, skipping]" instead
# of crashing. Any standard SMTP provider works (Gmail app password,
# SendGrid, Mailgun, etc).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- WhatsApp (Twilio) ---
# Used for: daily diet plan delivery via WhatsApp.
# If left blank, the app will log "[WhatsApp not configured, skipping]"
# instead of crashing. See https://www.twilio.com/docs/whatsapp for setup.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
